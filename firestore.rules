rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // require the signed in account to own this user path
    function owner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }
    // validate expense fields before accepting a write
    function validExpense() {
      let data = request.resource.data;
      // require the expected fields and reject extra fields
      return data.keys().hasAll(['amountMinor', 'currency', 'amountUsdMinor',
          'exchangeRate', 'rateDate', 'category', 'description', 'expenseDate', 'updatedAt'])
        && data.keys().hasOnly(['amountMinor', 'currency', 'amountUsdMinor',
          'exchangeRate', 'rateDate', 'category', 'description', 'expenseDate', 'updatedAt'])
        // store original and converted amounts as bounded integers
        && data.amountMinor is int && data.amountMinor > 0 && data.amountMinor <= 1000000000000
        && data.amountUsdMinor is int && data.amountUsdMinor >= 0 && data.amountUsdMinor <= 1000000000000
        // allow only supported currency codes
        && data.currency in ['USD', 'EUR', 'GBP', 'JPY', 'KRW', 'CAD', 'AUD', 'CNY']
        && data.exchangeRate is number && data.exchangeRate > 0
        // require valid dates and reject future purchases
        && data.rateDate is timestamp
        && data.expenseDate is timestamp && data.expenseDate <= request.time
        // limit category and description lengths
        && data.category is string && data.category.size() >= 2 && data.category.size() <= 24
        && data.description is string && data.description.size() <= 200
        // require the update timestamp to come from the server
        && data.updatedAt == request.time;
    }
    // allow built in categories or choices saved by this account
    function validCategory(userId) {
      let category = request.resource.data.category;
      let path = /databases/$(database)/documents/users/$(userId)/settings/preferences;
      return category in ['Housing', 'Groceries', 'Dining', 'Transportation',
          'Bills', 'Subscriptions', 'Shopping', 'Entertainment', 'Travel',
          'Health', 'Education', 'Other']
        || (exists(path)
          && get(path).data.customCategories is list
          && category in get(path).data.customCategories);
    }
    // restrict expense access to the owning account
    match /users/{userId}/expenses/{expenseId} {
      allow read, delete: if owner(userId);
      allow create: if owner(userId) && validExpense() && validCategory(userId);
      // keep old custom labels editable after removing them from settings
      allow update: if owner(userId) && validExpense()
        && (validCategory(userId) || request.resource.data.category == resource.data.category);
    }
    // validate budget and preferred currency account settings
    match /users/{userId}/settings/preferences {
      allow read: if owner(userId);
      allow create, update: if owner(userId)
        // require shared fields and reject unknown settings
        && request.resource.data.keys().hasAll(['reportingCurrency', 'updatedAt'])
        && request.resource.data.keys().hasAny(['monthlyBudgetMinor', 'preferredEntryCurrency', 'customCategories'])
        && request.resource.data.keys().hasOnly(['monthlyBudgetMinor', 'preferredEntryCurrency', 'customCategories', 'reportingCurrency', 'updatedAt'])
        // validate the budget only when it exists
        && (!request.resource.data.keys().hasAny(['monthlyBudgetMinor'])
          || (request.resource.data.monthlyBudgetMinor is int
            && request.resource.data.monthlyBudgetMinor > 0
            && request.resource.data.monthlyBudgetMinor <= 1000000000000))
        // validate the preferred currency only when it exists
        && (!request.resource.data.keys().hasAny(['preferredEntryCurrency'])
          || request.resource.data.preferredEntryCurrency in ['USD', 'EUR', 'GBP', 'JPY', 'KRW', 'CAD', 'AUD', 'CNY'])
        // limit account-only custom categories
        && (!request.resource.data.keys().hasAny(['customCategories'])
          || (request.resource.data.customCategories is list
            && request.resource.data.customCategories.size() <= 10))
        && request.resource.data.reportingCurrency == 'USD'
        && request.resource.data.updatedAt == request.time;
    }
    // all other paths remain denied
  }
}
